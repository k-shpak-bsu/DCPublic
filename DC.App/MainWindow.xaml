<Window x:Class="DC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DC.App"
        Title="Parallel Proof-of-Work Lab" Width="1200" Height="980"
        MinWidth="930" MinHeight="760" Background="#F4F5F7" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="PlotPanel" TargetType="GroupBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="ProcessorLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#475569" />
            <TextBlock Text="Parallel Proof-of-Work Lab" FontSize="24" FontWeight="SemiBold" />
        </DockPanel>
        <GroupBox Grid.Row="1" Header="Challenge parameters">
            <StackPanel>
                <Grid x:Name="InputFields">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Seed (six digits)" Margin="0,0,0,4" />
                        <TextBox x:Name="SeedInput" Text="583127" MaxLength="6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Difficulty (1–24 bits)" Margin="0,0,0,4" />
                        <TextBox x:Name="DifficultyInput" Text="20" MaxLength="2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Parallel workers (1–100)" Margin="0,0,0,4" />
                        <TextBox x:Name="WorkersInput" Text="1" MaxLength="3" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Solver implementation" Margin="0,0,0,4" />
                        <ComboBox x:Name="ImplementationInput" Padding="7,4" MinHeight="30" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" MinWidth="85" Margin="0,0,8,4" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsEnabled="False" Margin="0,0,16,4" />
                    <CheckBox x:Name="CollectMeasurementsBox" Content="Collect live measurements" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,4"
                              ToolTip="Samples at about 4 Hz and adds coarse search counters. Disable for cleaner timing; scaling records remain available." />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Execution">
            <StackPanel>
                <TextBlock x:Name="StatusLabel" Text="Status: Ready" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionLabel" Text="100 independent challenges. No session started." Foreground="#475569" Margin="0,4,0,6" TextWrapping="Wrap" FontSize="11" />
                <WrapPanel>
                    <TextBlock x:Name="CompletedLabel" Text="Completed: 0 / 100" Margin="0,0,22,0" />
                    <TextBlock x:Name="ElapsedLabel" Text="Elapsed: 00:00:00.000" Margin="0,0,22,0" />
                    <TextBlock x:Name="WorkerLabel" Text="Parallel workers: —" />
                </WrapPanel>
                <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Value="0" Height="9" Margin="0,7,0,6" />
                <TextBlock x:Name="AttemptsLabel" Text="SHA-256 attempts: —" TextWrapping="Wrap" />
                <TextBlock x:Name="MetricsSummary" Text="Live charts show measured work assignment, not simulated CPU activity." Foreground="#475569" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                <Expander Header="Previous completed run" Margin="0,4,0,0">
                    <TextBlock x:Name="PreviousRunLabel" Text="No previous run." TextWrapping="Wrap" FontSize="11" Foreground="#475569" />
                </Expander>
            </StackPanel>
        </GroupBox>

        <TabControl Grid.Row="3" Background="Transparent" BorderBrush="#CBD5E1">
            <TabItem Header="Live execution">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4" FontSize="11" Foreground="#475569" TextWrapping="Wrap"
                               Text="A matching 1-worker run adds a measured reference. Worker lanes show assigned wall time; CPU counts include all app threads. Neither is parallel efficiency. Very short runs may finish between samples." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MinHeight="390">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <GroupBox Header="Completed puzzles over time" Style="{StaticResource PlotPanel}">
                                <local:LabChart x:Name="CompletionChart" Kind="Completion" MinHeight="150" />
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="Hash throughput over time" Style="{StaticResource PlotPanel}">
                                <local:LabChart x:Name="ThroughputChart" Kind="Throughput" MinHeight="150" />
                            </GroupBox>
                            <GroupBox Grid.Row="1" Header="Assigned workers vs process CPU use" Style="{StaticResource PlotPanel}">
                                <local:LabChart x:Name="CapacityChart" Kind="Capacity" MinHeight="150" />
                            </GroupBox>
                            <GroupBox Grid.Row="1" Grid.Column="1" Header="Worker assignment timeline · hover for details" Style="{StaticResource PlotPanel}">
                                <local:LabChart x:Name="WorkerTimelineChart" Kind="Workers" MinHeight="150" />
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Puzzle durations">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="4" MinHeight="350">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="4,6">
                        <TextBlock Text="Histogram measure:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="HistogramMeasureInput" Width="210" SelectedIndex="0" SelectionChanged="HistogramMeasure_SelectionChanged">
                            <ComboBoxItem Content="Elapsed solving time" />
                            <ComboBoxItem Content="Hash attempts / puzzle" />
                        </ComboBox>
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <GroupBox Header="Elapsed time per puzzle · hover for details" Style="{StaticResource PlotPanel}">
                            <local:LabChart x:Name="PuzzleTimesChart" Kind="PuzzleTimes" MinHeight="190" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Distribution of solved puzzles" Style="{StaticResource PlotPanel}">
                            <local:LabChart x:Name="HistogramChart" Kind="Histogram" MinHeight="190" />
                        </GroupBox>
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="8" FontSize="11" Foreground="#475569" TextWrapping="Wrap"
                               Text="Elapsed time starts at the first assigned search and ends when a solution is reported; it includes off-core time and cooperative gaps. Orange bars are unfinished lower bounds. The histogram excludes unfinished puzzles, so its live sample is biased toward quick solves. Under the independent-hash model, baseline attempt counts are geometric (approximately exponential at high difficulty), not normally distributed." />
                </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Speedup &amp; limits">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8" MinHeight="350">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Content="Clear recorded timings" Click="ClearHistory_Click" Margin="12,0,0,8" />
                        <StackPanel>
                            <TextBlock x:Name="ScalingContextLabel" Text="Complete runs with 1 worker and then more workers." TextWrapping="Wrap" />
                            <TextBlock x:Name="EfficiencyLabel" Text="A matching 1-worker reference is required." Margin="0,5,0,8" Foreground="#475569" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <local:LabChart x:Name="SpeedupChart" Grid.Row="1" Kind="Speedup" MinHeight="190" />
                    <TextBlock Grid.Row="2" Foreground="#475569" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,4"
                               Text="Only completed runs with matching implementation, seed, difficulty and measurement mode are compared. Points use medians; the dashed p× line is an ideal equal-work reference, not a prediction for logical processors. Time speedup mixes processing speed and search effort; hashes/s scaling helps separate them. Timings alone do not establish correctness—validate results. Up to 30 runs are retained in memory." />
                </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Results &amp; validation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <GroupBox Header="Independent validation">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="ValidateButton" Content="Validate All Results" Click="ValidateButton_Click" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="CopyButton" Content="Copy Results as JSON" Click="CopyButton_Click" IsEnabled="False" Margin="0,0,0,4" />
                                </WrapPanel>
                                <TextBlock Text="Every validation reconstructs and hashes the submitted nonces using the original session parameters." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8" />
                                <TextBox x:Name="ValidationOutput" Text="Validation: Not run" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Height="150" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </GroupBox>
                        <Expander Header="Individual nonces · all 100 tasks">
                            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" Height="290" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="100" />
                                    <DataGridTextColumn Header="Nonce" Binding="{Binding Nonce}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="4" Background="#E8EEF6" Padding="9" Margin="0,8,0,0">
            <TextBlock x:Name="Message" Text="Default difficulty: 20 bits. No computation starts until you click Start." TextWrapping="Wrap" Foreground="#26364D" />
        </Border>
    </Grid>
</Window>
